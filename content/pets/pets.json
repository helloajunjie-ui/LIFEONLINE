{
  "schema": "pets/1",
  "id": "pets.default",
  "note": "宠物系统：在宠物之家领养，回家后在室内自由活动。宠物有饱腹/心情/清洁三项需求，随游戏时间衰减；喂食、撸、玩、洗澡可恢复。宠物粮在宠物之家按包购买。",
  "needs": {
    "note": "三项需求均为 0-100，越低越需要照顾；decayPerGameMinute 为每游戏分钟衰减量（对齐玩家数值按游戏分钟衰减的铁律）",
    "hunger": { "label": "饱腹", "initial": 85, "decayPerGameMinute": 0.045 },
    "mood":   { "label": "心情", "initial": 80, "decayPerGameMinute": 0.035 },
    "clean":  { "label": "清洁", "initial": 90, "decayPerGameMinute": 0.022 }
  },
  "petfood": {
    "name": "宠物粮",
    "unit": "份",
    "pack": 5,
    "price": 30,
    "note": "一包 5 份，喂食一次消耗 1 份",
    "feedHunger": 38,
    "feedMood": 4
  },
  "actions": {
    "feed": { "label": "喂食", "durationSec": 2, "sfx": "ok", "desc": "喂一份宠物粮，恢复饱腹" },
    "pet":  { "label": "撸一撸", "durationSec": 2, "sfx": "ok", "mood": 16, "playerEmotion": 6, "desc": "摸摸它，它和你都开心" },
    "play": { "label": "玩一会", "durationSec": 3, "sfx": "ok", "mood": 30, "hunger": -6, "playerEmotion": 9, "desc": "用逗猫棒/球玩一局，更开心但会饿" },
    "wash": { "label": "洗澡", "durationSec": 3, "sfx": "ok", "clean": 45, "mood": -6, "playerEmotion": 2, "desc": "洗干净，多数宠物不太喜欢" }
  },
  "moodFeedback": {
    "note": "宠物整体状态会反过来影响玩家情绪：低需求宠物让人心疼，健康宠物让人治愈",
    "happyThreshold": 70,
    "happyPlayerEmotionPerPet": 1,
    "sadThreshold": 30,
    "sadFloat": "看起来蔫蔫的，多陪陪它吧"
