{
  "schema": "environment/1",
  "note": "随机物与生长：全部由种子确定性生成，不入存档（否则每加一棵草都要写库）。玩家亲手种/浇的东西例外，存进存档的 planted[]。 daily = 每天一条的小区广播。",
  "scatter": {
    "note": "按格子哈希决定是否生成，同一 seed + 同一格永远得到同一个结果 → 换设备/串门看到的是同一片草地",
    "densityPer100": {
      "flower": 6,
      "grass": 12,
      "stone": 3,
      "mushroom": 2
    },
    "zones": {
      "yard": {
        "kinds": [
          "flower",
          "grass",
          "stone"
        ],
        "excludeNearHouse": 1
      },
      "street": {
        "kinds": [
          "grass",
          "stone"
        ],
        "excludeRoads": true
      }
    }
  },
  "growth": {
    "note": "装饰物生长阶段由「种下时间 + 当前时间」推导，不写状态机",
    "stages": [
      {
        "id": "seed",
        "afterMinutes": 0,
        "scale": 0.45
      },
      {
        "id": "sprout",
        "afterMinutes": 720,
        "scale": 0.7
      },
      {
        "id": "bloom",
        "afterMinutes": 2160,
        "scale": 1
      }
    ],
    "waterBonusMinutes": 240
  },
  "traffic": {
    "note": "车流：位置 = f(当前秒, 车道, 车号)，不需要服务端广播，也不需要存档。speedPerMinute 是游戏分钟口径（很慢，只用于逻辑推演），实际观感用 speedPerSecond。",
    "speedPerMinute": 0.08,
    "speedPerSecond": 2.4,
    "carsPerLane": 3,
    "kinds": [
      "car.red",
      "car.blue",
      "car.gray",
      "bike"
    ],
    "light": {
      "note": "红绿灯：两个相位交替（横绿/纵绿），周期秒数由它决定；车辆在红灯前 0.6 格停车，行人站在斑马线上时两侧都停。",
      "cycleSec": 16
    }
  },
  "daily": {
    "note": "每天一条小区广播：按游戏日做稳定散列挑一句，同一天读档重进还是同一句（和股票行情一个道理，不存盘）。when=any 是无条件池，when=rain 只在雨天参与。写的时候按街坊会说的话来，不要写成系统提示。",
    "lines": [
      {
        "when": "any",
        "text": "三号楼电梯检修，今天走楼梯吧。"
      },
      {
        "when": "any",
        "text": "周六上午广场有旧物交换，带点东西去。"
      },
      {
        "when": "any",
        "text": "物业提醒：楼道别堆杂物，消防通道要留着。"
      },
      {
        "when": "any",
        "text": "门口早餐铺出摊了，豆浆两块一碗。"
      },
      {
        "when": "any",
        "text": "有人丢了一只黄猫，见着了招呼一声。"
      },
      {
        "when": "any",
        "text": "广场的象棋摊又支起来了，下午最热闹。"
      },
      {
        "when": "any",
        "text": "快递柜满了，记得早点去取。"
      },
      {
        "when": "any",
        "text": "楼下小孩在学骑车，路过慢一点。"
      },
      {
        "when": "any",
        "text": "花坛的月季开了一丛，路过能闻见。"
      },
      {
        "when": "any",
        "text": "今晚广场放露天电影，八点开场。"
      },
      {
        "when": "any",
        "text": "小区群里在团鸡蛋，一板十五，明天到。"
      },
      {
        "when": "any",
        "text": "收废品的老陈今天在西门，纸箱别扔。"
      },
      {
        "when": "rain",
        "text": "下雨了，晾在外面的被子收一下。"
      },
      {
        "when": "rain",
        "text": "地下车库返潮，走的时候小心打滑。"
      },
      {
        "when": "rain",
        "text": "雨不小，路上那几个水洼别踩。"
      }
    ]
  }
}
