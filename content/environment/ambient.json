{
  "schema": "environment/1",
  "note": "随机物与生长：全部由种子确定性生成，不入存档（否则每加一棵草都要写库）。玩家亲手种/浇的东西例外，存进存档的 planted[]。 daily = 每天一条的小区广播。",
  "scatter": {
    "note": "按格子哈希决定是否生成，同一 seed + 同一格永远得到同一个结果 → 换设备/串门看到的是同一片草地",
    "densityPer100": {
      "flower": 6,
      "grass": 12,
      "stone": 3,
      "mushroom": 2
    },
    "zones": {
      "yard": {
        "kinds": [
          "flower",
          "grass",
          "stone"
        ],
        "excludeNearHouse": 1
      },
      "street": {
        "kinds": [
          "grass",
          "stone"
        ],
        "excludeRoads": true
      }
    }
  },
  "growth": {
    "note": "装饰物生长阶段由「种下时间 + 当前时间」推导，不写状态机",
    "stages": [
      {
        "id": "seed",
        "afterMinutes": 0,
        "scale": 0.45
      },
      {
        "id": "sprout",
        "afterMinutes": 720,
        "scale": 0.7
      },
      {
        "id": "bloom",
        "afterMinutes": 2160,
        "scale": 1
      }
    ],
    "waterBonusMinutes": 240
  },
  "traffic": {
    "note": "车流：位置 = f(当前秒, 车道, 车号)，不需要服务端广播，也不需要存档。speedPerMinute 是游戏分钟口径（很慢，只用于逻辑推演），实际观感用 speedPerSecond。 types 是车型表：weight 是相对权重，where=arterial 只跑主干道（中央大道/南环路），speedMul 是相对速度。 nearZones 让车型按路段加权：靠近哪类设施，那类车就多。",
    "speedPerMinute": 0.08,
    "speedPerSecond": 2.4,
    "carsPerLane": 3,
    "kinds": [],
    "light": {
      "note": "红绿灯：两个相位交替（横绿/纵绿），周期秒数由它决定；车辆在红灯前 0.6 格停车，行人站在斑马线上时两侧都停。",
      "cycleSec": 16
    },
    "types": [
      {
        "id": "car.sedan",
        "label": "私家车",
        "weight": 34,
        "where": "any",
        "speedMul": 1,
        "colors": [
          "#c8553d",
          "#4a6fa8",
          "#8b8b8b",
          "#5e7a52",
          "#b08a5a"
        ],
        "note": "街上最多的那种。随机配色，跟 4S 店卖的车区分开（那是玩家自己的车）"
      },
      {
        "id": "car.taxi",
        "label": "网约车",
        "weight": 12,
        "where": "any",
        "speedMul": 1.05,
        "color": "#2f6f5a",
        "roofColor": "#f2ede2",
        "beacon": "#e8d47a",
        "note": "绿牌网约车，车顶小灯常亮（不闪，跟警灯区分）",
        "nearZones": {
          "plaza": 2,
          "shop_car": 1
        }
      },
      {
        "id": "car.van",
        "label": "快递车",
        "weight": 12,
        "where": "any",
        "speedMul": 0.92,
        "color": "#f2efe8",
        "roofColor": "#dcd6c8",
        "len": 1.25,
        "wid": 1.06,
        "boxy": true,
        "note": "方厢小货车，跑得比轿车慢一点；快递站在东商业街，送货车满街都是才合理",
        "nearZones": {
          "shop4": 2,
          "shop_super": 1.5,
          "shop3": 1.5
        },
        "nearNote": "靠近快递站/超市/菜市场的路段，快递车权重 ×3——送货车应该聚在要送货的地方，而不是均匀撒满全图"
      },
      {
        "id": "car.bus",
        "label": "公交车",
        "weight": 9,
        "where": "arterial",
        "speedMul": 0.8,
        "color": "#3f6fa8",
        "roofColor": "#e9eef3",
        "len": 1.75,
        "wid": 1.08,
        "stripe": "#f2f6fa",
        "note": "只跑中央大道和南环路这两条主干道。车长是轿车 1.75 倍——再长路口就拐不过弯了"
      },
      {
        "id": "car.police",
        "label": "警车",
        "weight": 4,
        "where": "any",
        "speedMul": 1.15,
        "color": "#f4f4f2",
        "roofColor": "#2a3a55",
        "stripe": "#2a3a55",
        "beacon": "#3a6ee8",
        "flash": true,
        "note": "白底蓝条，车顶蓝灯闪。比普通车快一点，但不快过救护车",
        "nearZones": {
          "police": 2
        }
      },
      {
        "id": "car.ambulance",
        "label": "救护车",
        "weight": 4,
        "where": "any",
        "speedMul": 1.3,
        "color": "#f6f4f0",
        "roofColor": "#e4e0d8",
        "stripe": "#c0392b",
        "beacon": "#e0453a",
        "flash": true,
        "note": "白底红条，车顶红灯闪，全场最快——社区医院就在小区里，救护车该跑得急",
        "nearZones": {
          "hospital": 2
        }
      },
      {
        "id": "car.sanitation",
        "label": "环卫车",
        "weight": 4,
        "where": "any",
        "speedMul": 0.72,
        "color": "#6d8a5f",
        "roofColor": "#5a7350",
        "len": 1.3,
        "wid": 1.1,
        "boxy": true,
        "note": "慢吞吞的扫地车，给街道一点层次，不然满街都是一种车"
      },
      {
        "id": "bike",
        "label": "电动车",
        "weight": 11,
        "where": "any",
        "speedMul": 0.85,
        "note": "外卖/通勤电动车，原来就有"
      }
    ]
  },
  "daily": {
    "note": "每天一条小区广播：按游戏日做稳定散列挑一句，同一天读档重进还是同一句（和股票行情一个道理，不存盘）。when=any 是无条件池，when=rain 只在雨天参与。写的时候按街坊会说的话来，不要写成系统提示。",
    "lines": [
      {
        "when": "any",
        "text": "三号楼电梯检修，今天走楼梯吧。"
      },
      {
        "when": "any",
        "text": "周六上午广场有旧物交换，带点东西去。"
      },
      {
        "when": "any",
        "text": "物业提醒：楼道别堆杂物，消防通道要留着。"
      },
      {
        "when": "any",
        "text": "门口早餐铺出摊了，豆浆两块一碗。"
      },
      {
        "when": "any",
        "text": "有人丢了一只黄猫，见着了招呼一声。"
      },
      {
        "when": "any",
        "text": "广场的象棋摊又支起来了，下午最热闹。"
      },
      {
        "when": "any",
        "text": "快递柜满了，记得早点去取。"
      },
      {
        "when": "any",
        "text": "楼下小孩在学骑车，路过慢一点。"
      },
      {
        "when": "any",
        "text": "花坛的月季开了一丛，路过能闻见。"
      },
      {
        "when": "any",
        "text": "今晚广场放露天电影，八点开场。"
      },
      {
        "when": "any",
        "text": "小区群里在团鸡蛋，一板十五，明天到。"
      },
      {
        "when": "any",
        "text": "收废品的老陈今天在西门，纸箱别扔。"
      },
      {
        "when": "rain",
        "text": "下雨了，晾在外面的被子收一下。"
      },
      {
        "when": "rain",
        "text": "地下车库返潮，走的时候小心打滑。"
      },
      {
        "when": "rain",
        "text": "雨不小，路上那几个水洼别踩。"
      }
    ]
  },
  "chatter": {
    "note": "街坊之间闲聊：两个人站得够近就自己搭话，附近没人时改说一句独白。纯表现层——不写存档、不改数值，加多少句台词都不会影响平衡。lines 按 a/b 交替念；when 决定进哪个池子（any / morning / day / eve / night / rain）。句子控制在 16 字以内，多了会在气泡里折成两行、读着费劲。",
    "cooldownMinutes": 26,
    "cooldownJitter": 22,
    "rangeTiles": 5,
    "topics": [
      {
        "id": "weather-muggy",
        "when": "any",
        "lines": [
          { "s": "a", "t": "这天儿闷得很，怕是要下雨。" },
          { "s": "b", "t": "预报说夜里就下，衣服得收。" }
        ]
      },
      {
        "id": "bus-morning",
        "when": "morning",
        "lines": [
          { "s": "a", "t": "你今儿还是坐二路来的？" },
          { "s": "b", "t": "嗯，两块钱，比走过去省事。" }
        ]
      },
      {
        "id": "estate-price",
        "when": "any",
        "lines": [
          { "s": "a", "t": "听说东边那排公寓又涨价了。" },
          { "s": "b", "t": "涨吧，反正我也买不起。" }
        ]
      },
      {
        "id": "new-worker",
        "when": "day",
        "lines": [
          { "s": "a", "t": "新来那小伙子干活挺利索。" },
          { "s": "b", "t": "看着像个能往上升的。" }
        ]
      },
      {
        "id": "market-greens",
        "when": "morning",
        "lines": [
          { "s": "a", "t": "这青菜早上刚到的。" },
          { "s": "b", "t": "给我来两把，晚上炒个素的。" }
        ]
      },
      {
        "id": "lottery",
        "when": "eve",
        "lines": [
          { "s": "a", "t": "昨儿那期你买了吗？" },
          { "s": "b", "t": "买了，一个号都没对上。" }
        ]
      },
      {
        "id": "cat-out",
        "when": "eve",
        "lines": [
          { "s": "a", "t": "你家那只猫又跑出来了。" },
          { "s": "b", "t": "它认路，饿了就自己回去。" }
        ]
      },
      {
        "id": "clinic-queue",
        "when": "any",
        "lines": [
          { "s": "a", "t": "门诊的队都排到门外了。" },
          { "s": "b", "t": "换季嘛，咳嗽的多。" }
        ]
      },
      {
        "id": "school-crossing",
        "when": "morning",
        "lines": [
          { "s": "a", "t": "放学别在路口追着跑。" },
          { "s": "b", "t": "知道啦——" }
        ]
      },
      {
        "id": "court-again",
        "when": "eve",
        "lines": [
          { "s": "a", "t": "再来一场？" },
          { "s": "b", "t": "天都快黑了，明儿吧。" }
        ]
      },
      {
        "id": "park-late",
        "when": "night",
        "lines": [
          { "s": "a", "t": "这么晚还遛弯？" },
          { "s": "b", "t": "睡不着，走两圈。" }
        ]
      },
      {
        "id": "rain-endless",
        "when": "rain",
        "lines": [
          { "s": "a", "t": "这雨下得没完没了。" },
          { "s": "b", "t": "屋檐底下站会儿吧。" }
        ]
      },
      {
        "id": "rain-umbrella",
        "when": "rain",
        "lines": [
          { "s": "a", "t": "伞借你吧，我跑两步就到。" },
          { "s": "b", "t": "那你不得淋透了。" }
        ]
      },
      {
        "id": "coffee-order",
        "when": "any",
        "lines": [
          { "s": "a", "t": "一杯美式，不加糖。" },
          { "s": "b", "t": "稍等，马上好。" }
        ]
      },
      {
        "id": "parcel-rush",
        "when": "day",
        "lines": [
          { "s": "a", "t": "今天件儿怎么这么多。" },
          { "s": "b", "t": "网购打折，一窝蜂都下单。" }
        ]
      },
      {
        "id": "bbq-open",
        "when": "eve",
        "lines": [
          { "s": "a", "t": "烧烤摊儿支起来了。" },
          { "s": "b", "t": "闻着味儿就过来了。" }
        ]
      },
      {
        "id": "bank-rate",
        "when": "any",
        "lines": [
          { "s": "a", "t": "利率又降了。" },
          { "s": "b", "t": "存着吧，总比乱花了强。" }
        ]
      },
      {
        "id": "balcony-flower",
        "when": "any",
        "lines": [
          { "s": "a", "t": "你家阳台那盆花开得真好。" },
          { "s": "b", "t": "回头剪一枝给你插。" }
        ]
      },
      {
        "id": "night-bus",
        "when": "night",
        "lines": [
          { "s": "a", "t": "末班车几点？" },
          { "s": "b", "t": "十点半，再不走就赶不上。" }
        ]
      },
      {
        "id": "night-shift",
        "when": "night",
        "lines": [
          { "s": "a", "t": "这么晚还不睡？" },
          { "s": "b", "t": "刚换下夜班，还醒着。" }
        ]
      },
      {
        "id": "stock-green",
        "when": "day",
        "lines": [
          { "s": "a", "t": "你那只票今儿绿得发亮。" },
          { "s": "b", "t": "别提了，我还在等回本。" }
        ]
      },
      {
        "id": "rent-day",
        "when": "any",
        "lines": [
          { "s": "a", "t": "这月房租交了吗？" },
          { "s": "b", "t": "交了，一到月初就肉疼。" }
        ]
      },
      {
        "id": "kid-play",
        "when": "day",
        "lines": [
          { "s": "a", "t": "操场那边又开踢了。" },
          { "s": "b", "t": "喊上老李，正好凑一队。" }
        ]
      }
    ],
    "solos": [
      { "when": "any", "t": "今天怎么这么冷清。" },
      { "when": "any", "t": "这账算得我脑仁疼。" },
      { "when": "any", "t": "又到月底了……" },
      { "when": "any", "t": "门口这盆花该浇水了。" },
      { "when": "any", "t": "谁家又炖肉了，香得慌。" },
      { "when": "any", "t": "明天得去趟菜市场。" },
      { "when": "morning", "t": "早上的风倒是挺凉快。" },
      { "when": "day", "t": "站一天了，腰有点酸。" },
      { "when": "day", "t": "公交怎么又晚点。" },
      { "when": "eve", "t": "再撑一会儿就收摊。" },
      { "when": "night", "t": "路灯该修了，一闪一闪的。" },
      { "when": "night", "t": "这个点，街上就剩风了。" },
      { "when": "rain", "t": "这雨下得，路上全是泥。" },
      { "when": "rain", "t": "屋檐水都成串了。" }
    ]
  }
}
