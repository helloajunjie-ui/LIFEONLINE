{
  "schema": "environment/1",
  "note": "随机物与生长：全部由种子确定性生成，不入存档（否则每加一棵草都要写库）。玩家亲手种/浇的东西例外，存进存档的 planted[]。 daily = 每天一条的小区广播。",
  "scatter": {
    "note": "按格子哈希决定是否生成，同一 seed + 同一格永远得到同一个结果 → 换设备/串门看到的是同一片草地",
    "densityPer100": {
      "flower": 6,
      "grass": 12,
      "stone": 3,
      "mushroom": 2
    },
    "zones": {
      "yard": {
        "kinds": [
          "flower",
          "grass",
          "stone"
        ],
        "excludeNearHouse": 1
      },
      "street": {
        "kinds": [
          "grass",
          "stone"
        ],
        "excludeRoads": true
      }
    }
  },
  "growth": {
    "note": "装饰物生长阶段由「种下时间 + 当前时间」推导，不写状态机",
    "stages": [
      {
        "id": "seed",
        "afterMinutes": 0,
        "scale": 0.45
      },
      {
        "id": "sprout",
        "afterMinutes": 720,
        "scale": 0.7
      },
      {
        "id": "bloom",
        "afterMinutes": 2160,
        "scale": 1
      }
    ],
    "waterBonusMinutes": 240
  },
  "traffic": {
    "note": "车流：位置 = f(当前秒, 车道, 车号)，不需要服务端广播，也不需要存档。speedPerMinute 是游戏分钟口径（很慢，只用于逻辑推演），实际观感用 speedPerSecond。 types 是车型表：weight 是相对权重，where=arterial 只跑主干道（中央大道/南环路），speedMul 是相对速度。 nearZones 让车型按路段加权：靠近哪类设施，那类车就多。",
    "speedPerMinute": 0.08,
    "speedPerSecond": 2.4,
    "carsPerLane": 3,
    "kinds": [],
    "light": {
      "note": "红绿灯：两个相位交替（横绿/纵绿），周期秒数由它决定；车辆在红灯前 0.6 格停车，行人站在斑马线上时两侧都停。",
      "cycleSec": 16
    },
    "types": [
      {
        "id": "car.sedan",
        "label": "私家车",
        "weight": 34,
        "where": "any",
        "speedMul": 1,
        "colors": [
          "#c8553d",
          "#4a6fa8",
          "#8b8b8b",
          "#5e7a52",
          "#b08a5a"
        ],
        "note": "街上最多的那种。随机配色，跟 4S 店卖的车区分开（那是玩家自己的车）"
      },
      {
        "id": "car.taxi",
        "label": "网约车",
        "weight": 12,
        "where": "any",
        "speedMul": 1.05,
        "color": "#2f6f5a",
        "roofColor": "#f2ede2",
        "beacon": "#e8d47a",
        "note": "绿牌网约车，车顶小灯常亮（不闪，跟警灯区分）",
        "nearZones": {
          "plaza": 2,
          "shop_car": 1
        }
      },
      {
        "id": "car.van",
        "label": "快递车",
        "weight": 12,
        "where": "any",
        "speedMul": 0.92,
        "color": "#f2efe8",
        "roofColor": "#dcd6c8",
        "len": 1.25,
        "wid": 1.06,
        "boxy": true,
        "note": "方厢小货车，跑得比轿车慢一点；快递站在东商业街，送货车满街都是才合理",
        "nearZones": {
          "shop4": 2,
          "shop_super": 1.5,
          "shop3": 1.5
        },
        "nearNote": "靠近快递站/超市/菜市场的路段，快递车权重 ×3——送货车应该聚在要送货的地方，而不是均匀撒满全图"
      },
      {
        "id": "car.bus",
        "label": "公交车",
        "weight": 9,
        "where": "arterial",
        "speedMul": 0.8,
        "color": "#3f6fa8",
        "roofColor": "#e9eef3",
        "len": 1.75,
        "wid": 1.08,
        "stripe": "#f2f6fa",
        "note": "只跑中央大道和南环路这两条主干道。车长是轿车 1.75 倍——再长路口就拐不过弯了"
      },
      {
        "id": "car.police",
        "label": "警车",
        "weight": 4,
        "where": "any",
        "speedMul": 1.15,
        "color": "#f4f4f2",
        "roofColor": "#2a3a55",
        "stripe": "#2a3a55",
        "beacon": "#3a6ee8",
        "flash": true,
        "note": "白底蓝条，车顶蓝灯闪。比普通车快一点，但不快过救护车",
        "nearZones": {
          "police": 2
        }
      },
      {
        "id": "car.ambulance",
        "label": "救护车",
        "weight": 4,
        "where": "any",
        "speedMul": 1.3,
        "color": "#f6f4f0",
        "roofColor": "#e4e0d8",
        "stripe": "#c0392b",
        "beacon": "#e0453a",
        "flash": true,
        "note": "白底红条，车顶红灯闪，全场最快——社区医院就在小区里，救护车该跑得急",
        "nearZones": {
          "hospital": 2
        }
      },
      {
        "id": "car.sanitation",
        "label": "环卫车",
        "weight": 4,
        "where": "any",
        "speedMul": 0.72,
        "color": "#6d8a5f",
        "roofColor": "#5a7350",
        "len": 1.3,
        "wid": 1.1,
        "boxy": true,
        "note": "慢吞吞的扫地车，给街道一点层次，不然满街都是一种车"
      },
      {
        "id": "bike",
        "label": "电动车",
        "weight": 11,
        "where": "any",
        "speedMul": 0.85,
        "note": "外卖/通勤电动车，原来就有"
      }
    ]
  },
  "daily": {
    "note": "每天一条小区广播：按游戏日做稳定散列挑一句，同一天读档重进还是同一句（和股票行情一个道理，不存盘）。when=any 是无条件池，when=rain 只在雨天参与。写的时候按街坊会说的话来，不要写成系统提示。",
    "lines": [
      {
        "when": "any",
        "text": "三号楼电梯检修，今天走楼梯吧。"
      },
      {
        "when": "any",
        "text": "周六上午广场有旧物交换，带点东西去。"
      },
      {
        "when": "any",
        "text": "物业提醒：楼道别堆杂物，消防通道要留着。"
      },
      {
        "when": "any",
        "text": "门口早餐铺出摊了，豆浆两块一碗。"
      },
      {
        "when": "any",
        "text": "有人丢了一只黄猫，见着了招呼一声。"
      },
      {
        "when": "any",
        "text": "广场的象棋摊又支起来了，下午最热闹。"
      },
      {
        "when": "any",
        "text": "快递柜满了，记得早点去取。"
      },
      {
        "when": "any",
        "text": "楼下小孩在学骑车，路过慢一点。"
      },
      {
        "when": "any",
        "text": "花坛的月季开了一丛，路过能闻见。"
      },
      {
        "when": "any",
        "text": "今晚广场放露天电影，八点开场。"
      },
      {
        "when": "any",
        "text": "小区群里在团鸡蛋，一板十五，明天到。"
      },
      {
        "when": "any",
        "text": "收废品的老陈今天在西门，纸箱别扔。"
      },
      {
        "when": "rain",
        "text": "下雨了，晾在外面的被子收一下。"
      },
      {
        "when": "rain",
        "text": "地下车库返潮，走的时候小心打滑。"
      },
      {
        "when": "rain",
        "text": "雨不小，路上那几个水洼别踩。"
      }
    ]
  }
}
