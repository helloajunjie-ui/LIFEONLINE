    "lateEmotionPerDay": -1,
    "lateEmotionCap": -15,
    "paidEmotionBonus": 5,
    "keepPaid": 8,
    "maxOpen": 24
  },
  "bills": [
    {
      "id": "bill.rent",
      "title": "房租",
      "icon": "rent",
      "cycleDays": 7,
      "onlyWhen": "rented",
