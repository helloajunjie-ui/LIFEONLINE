      "unitNote": "公寓按楼层递增，独栋按建筑面积固定"
    },
    {
      "id": "bill.parking",
      "title": "停车费",
      "icon": "car",
      "cycleDays": 7,
      "onlyWhen": "car",
      "amount": { "flat": 12 },
