      "desc": "本季房租",
      "unitNote": "按房源月租 ÷ 30 天 × 7 天折算，租住才有这一单"
    },
    {
      "id": "bill.power",
      "title": "电费",
      "icon": "bolt",
      "cycleDays": 15,
      "onlyWhen": "always",
      "amount": { "base": 16, "perAppliance": 4 },
      "desc": "双月电费",
      "unitNote": "基本电费 16 元 + 每件电器 4 元（电器越多越贵）"
    },
    {
      "id": "bill.water",
      "title": "水费",
      "icon": "water",
      "cycleDays": 15,
      "onlyWhen": "always",
      "amount": { "base": 12, "perFloor": 0.3 },
      "desc": "双月水费",
      "unitNote": "基本水费 12 元 + 高层二次加压每层 0.3 元"
    },
    {
      "id": "bill.property",
      "title": "物业费",
      "icon": "building",
      "cycleDays": 30,
      "onlyWhen": "always",
      "amount": { "base": 38, "perFloor": 1, "villaBase": 62 },
